AUTH_SECRET=generate-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
TWELVE_DATA_API_KEY=your-twelve-data-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Optional. In most Vercel/localhost cases Auth.js can infer this.
# If you set it, use only one value per environment:
# local: AUTH_URL=http://localhost:3000
# vercel: AUTH_URL=https://your-project.vercel.app

# Optional. Useful on Vercel to force one stable Google callback URL:
# AUTH_REDIRECT_PROXY_URL=https://your-project.vercel.app/api/auth
